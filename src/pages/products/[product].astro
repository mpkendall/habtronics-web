---
import Layout from "../../layouts/Layout.astro";
import { getProductData, resolveStripeKey } from "../../lib/stripe";
const productDescriptions = import.meta.glob("../../content/*.{md,mdx}", {
  eager: true,
});

export const prerender = false;

const runtimeEnv = (Astro.locals as any)?.runtime?.env;
const stripeKey = resolveStripeKey(runtimeEnv);
const products = await getProductData(stripeKey, runtimeEnv);

const { product } = Astro.params;
const productData = products.find((p: any) => p.metadata.short === product);

const variants = productData?.metadata?.variants ?? [];
const hasVariants = Array.isArray(variants) && variants.length > 0;

// Default to parent product if no variants, otherwise first variant
const defaultVariant = hasVariants ? variants[0] : null;
const defaultStock = hasVariants ? defaultVariant.stock : Number(productData?.metadata?.stock);
const defaultPriceId = hasVariants ? defaultVariant.priceId : productData?.price_id;

const stock = Number(defaultStock);
console.log("Stock as number:", stock);
const productDesc = Object.values(productDescriptions).find(
  (p: any) => p.frontmatter.slug === product,
) as any;
---

<Layout class="!pb-0">
  <div
    id="product-page"
    class="-mt-20 grid grid-cols-1 lg:grid-cols-[minmax(280px,32%)_1fr] w-full min-h-screen"
  >
    <div
      id="showcase-section"
      class="bg-[#1B0C35] lg:min-h-screen flex items-center flex-col px-4"
    >
      <div id="content" class="lg:sticky lg:top-0 flex flex-col items-center w-full max-w-[420px] pb-8 lg:pb-0">
        <div class="mt-[80px] mb-5 w-full text-left">
          <a href="/shop" class="text-white font-sora text-lg hover-50">&lt; Back to Shop</a>
        </div>
        <img
          src={productData.image}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full max-w-[300px] object-cover rounded-2xl"
          alt={`${productData.name} product image`}
        />
        <p class="mt-5 text-white font-sora text-2xl md:text-3xl text-center">{productData.name}</p>
        
        {hasVariants && (
          <div class="w-full mt-6">
            <label for="variant-select" class="block text-white font-sora text-sm mb-2">Select Option:</label>
            <select
              id="variant-select"
              class="w-full px-4 py-2 rounded-lg bg-white text-black font-inter focus:outline-none focus:ring-2 focus:ring-purple-500"
            >
              {variants.map((variant: any) => (
                <option value={JSON.stringify({ name: variant.name, stock: variant.stock, priceId: variant.priceId })}>
                  {variant.name} (${Number(variant.price ?? 0).toFixed(2)})
                </option>
              ))}
            </select>
          </div>
        )}

        <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-8 mt-8 w-full justify-center">
          <button
            id="add-to-cart"
            class:list={[
              "font-sora text-lg px-6 min-h-11 rounded-xl",
              stock === 0
                ? "bg-gray-500 text-black cursor-not-allowed"
                : "bg-white text-black hover-50 cursor-pointer",
            ]}
            disabled={stock === 0}
          >
            {stock === 0 ? "Out of Stock" : "Add to Cart"}
          </button>
          <p id="price-display" class="font-sora text-xl text-white">${productData.price}</p>
        </div>
      </div>
    </div>
    <div id="product-info" class="px-5 md:px-10 lg:px-16">
      <div class="product-prose mt-[50px] lg:mt-[100px] pb-15 text-base md:text-xl">
        <productDesc.Content />
      </div>
    </div>
    <div
      id="tag-data"
      data-title={productData.name}
      data-price={productData.price}
      data-price-id={defaultPriceId}
      data-variants={hasVariants ? JSON.stringify(variants) : '[]'}
      data-has-variants={hasVariants.toString()}
    >
    </div>
  </div>

  <script>
    const addToCartButton = document.getElementById("add-to-cart");
    const dataDiv = document.getElementById("tag-data");
    const variantSelect = document.getElementById("variant-select");
    const priceDisplay = document.getElementById("price-display");

    function updateFromVariant() {
      if (variantSelect) {
        const selected = JSON.parse(variantSelect.value);
        const variants = JSON.parse(dataDiv!.getAttribute("data-variants") || "[]");
        const variant = variants.find((v: any) => v.priceId === selected.priceId);
        
        if (variant) {
          dataDiv!.setAttribute("data-price-id", variant.priceId);
          priceDisplay!.textContent = `$${Number(variant.price ?? 0).toFixed(2)}`;
          
          // Update button state
          if (variant.stock === 0) {
            addToCartButton!.disabled = true;
            addToCartButton!.textContent = "Out of Stock";
            addToCartButton!.classList.remove("bg-white", "hover-50", "cursor-pointer");
            addToCartButton!.classList.add("bg-gray-500", "cursor-not-allowed");
          } else {
            addToCartButton!.disabled = false;
            addToCartButton!.textContent = "Add to Cart";
            addToCartButton!.classList.remove("bg-gray-500", "cursor-not-allowed");
            addToCartButton!.classList.add("bg-white", "hover-50", "cursor-pointer");
          }
        }
      }
    }

    if (variantSelect) {
      variantSelect.addEventListener("change", updateFromVariant);
    }

    if (!addToCartButton?.hasAttribute("disabled")) {
      addToCartButton?.addEventListener("click", () => {
        let title = dataDiv!.getAttribute("data-title")!;
        const hasVariants = dataDiv!.getAttribute("data-has-variants") === "true";
        
        if (hasVariants && variantSelect) {
          const selected = JSON.parse(variantSelect.value);
          title = `${title} - ${selected.name}`;
        }

        addToCart(
          title,
          priceDisplay!.textContent!.replace("$", ""),
          dataDiv!.getAttribute("data-price-id")!,
        );
      });
    }

    function addToCart(title: any, price: any, priceId: any) {
      const cart = JSON.parse(localStorage.getItem("cart") || "[]");
      const productIndex = cart.findIndex(
        (item: { priceId: any }) => item.priceId === priceId,
      );

      if (productIndex > -1) {
        cart[productIndex].quantity += 1;
      } else {
        const product = { title, price, priceId, quantity: 1 };
        cart.push(product);
      }

      localStorage.setItem("cart", JSON.stringify(cart));
      alert(`${title} has been added to your cart!`);
    }
  </script>

</Layout>
